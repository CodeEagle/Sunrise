    "bubble.clear": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Beautiful day — let's go outside!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天天气真好,一起去外面走走吧!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いい天気だね、お散歩に行こう!"
          }
        }
      }
    },
    "bubble.cloudy": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clouds drifting by — what shape will they make next?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "云朵在变换形状,你猜像什么呢?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "雲が形を変えていくよ。次は何に見えるかな?"
          }
        }
      }
    },
    "bubble.rain": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't forget your umbrella!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记得带上伞,别让雨水打湿你哦~"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "傘を忘れずに持って行ってね!"
          }
        }
      }
    },
    "bubble.thunderstorm": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Storms incoming — stay safe indoors."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "雷雨来啦,注意安全,待在室内哦!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "雷雨が来るよ。お家で安全にね。"
          }
        }
      }
    },
    "bubble.snow": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Snowflakes! Let's build a snowman."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "雪花好美呀!一起堆个雪人吧~"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "雪だ!雪だるまを作ろう。"
          }
        }
      }
    },
    "bubble.windy": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold onto your hat — it's blustery out there!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "风儿在唱歌,抓紧帽子别被吹跑啦!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "帽子が飛ばされないように気をつけて!"
          }
        }
      }
    },
    "bubble.fog": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Misty morning — drive carefully."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "雾蒙蒙的清晨,出门小心哦。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "霧が出ているよ、運転は気をつけてね。"
          }
        }
      }
    },
