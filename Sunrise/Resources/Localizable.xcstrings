      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Language changes take effect after relaunching Sunrise."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换语言后，请重新启动 Sunrise 生效。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "言語の変更は Sunrise を再起動後に反映されます。"
          }
        }
      }
    },
