    "character.calm": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take a deep breath. The world will wait."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "深呼吸,世界会等等你的。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "深呼吸して。世界はちゃんと待ってる。"
          }
        }
      }
    },
    "character.tender": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunny is sending you warm wishes today."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "小晴今天悄悄给你一份温柔。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ハルから優しい気持ちを届けるね。"
          }
        }
      }
    },
    "character.worried": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunny is a little nervous. Stay close, okay?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "小晴有点点担心,陪着我好不好?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ちょっとドキドキしてる。そばにいてね。"
          }
        }
